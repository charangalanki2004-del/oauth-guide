# --- LLM (any OpenAI-compatible API) ---------------------------------------
# Pick a preset: gemini | deepseek | groq | openai | anthropic | custom
LLM_PROVIDER=gemini
LLM_API_KEY=your-key-here
# Optional overrides (presets fill these in if left blank)
LLM_MODEL=
LLM_BASE_URL=

# --- App ---------------------------------------------------------------------
# Public base URL used in shareable links (set this on your deploy host)
PUBLIC_BASE_URL=http://localhost:8000
# Set to 1 to run with a canned investigation (no API calls) for UI dev / demos
MOCK_MODE=0
# Max pages the agent fetches per investigation
MAX_PAGES=8

# --- Optional -----------------------------------------------------------------
# Tavily search (free tier) is more reliable than DuckDuckGo on cloud hosts
TAVILY_API_KEY=
# Lets the agent check Composio's managed-auth directory for the app
COMPOSIO_API_KEY=
